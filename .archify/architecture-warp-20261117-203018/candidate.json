  "cards": [
    {
      "dot": "cyan",
      "title": "双前端一核心",
      "items": [
        "GUI 与 TUI 都经 run_internal → initialize_app 装配同一套应用表面",
        "TUI 经 app::tui_export 复用 terminal / ai / drive / settings 模块"
      ]
    },
    {
      "dot": "emerald",
      "title": "终端范式",
      "items": [
        "自研 PTY：Unix 走 nix openpty，Windows 走手写 ConPTY 绑定（conpty.dll）",
        "shell 引导脚本注入钩子转义序列，命令与输出按 Block 划界"
      ]
    },
    {
      "dot": "rose",
      "title": "分层纪律",
      "items": [
        "warp_terminal 只依赖 warpui_core，不依赖平台后端与云 crate",
        "warpui / warpui_core 以 MIT 单独开源，可独立复用"
      ]
    }
